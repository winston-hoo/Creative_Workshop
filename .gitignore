# ── 隐私与运行时数据：一律不入库 ──────────────────────────
# 密钥（哪怕当前是空的，防止以后手滑填进去）
.env
config/.env
config/secrets.json

# 设置页维护的自定义服务商配置：含你接入的中转站/服务商与默认模型绑定
custom-providers.yaml

# 题材库运行时数据：作品 → 题材 映射随真实作品累积，属本地数据
genres/
compare/

# 作品数据：原文、标注、报告都带真实作品内容与作者本机绝对路径
workspaces/
config/annotations/

# 上传暂存与临时工作区：里面是整本原文
.tmp/

# 自检产生的模拟报告（跑一次生成一批，没有留存价值）
config/probe-reports/_selftest/

# ── 外部技法包：不入库 ────────────────────────────────────
# 数据根下的 craft/ 是给外部技法包留的位置（源码方式是这里，exe 是
# %LOCALAPPDATA%\创作工坊\craft）。放进去的同名篇目覆盖内置原创版。
# 从别处收来的内容版权归原作者，放公开仓库前先确认许可，所以整个目录排除。
# src/workshop/craft/ 里是本项目自己写的 12 篇，正常入库、随 exe 打包。
/craft/

# ── 常规忽略 ──────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# 打包产物：一律不进库。exe 走 Release 附件（.github/workflows/release-exe.yml），
# 二进制进了 git 就永久留在历史里，仓库会随版本膨胀。
build/
dist/
*.spec
