# ── 隐私与运行时数据：一律不入库 ──────────────────────────
# 密钥（哪怕当前是空的，防止以后手滑填进去）
.env
config/.env
config/secrets.json

# 设置页维护的自定义服务商配置：含你接入的中转站/服务商与默认模型绑定
custom-providers.yaml

# 题材库运行时数据：作品 → 题材 映射随真实作品累积，属本地数据
genres/
compare/

# 作品数据：原文、标注、报告都带真实作品内容与作者本机绝对路径
workspaces/
config/annotations/

# 上传暂存与临时工作区：里面是整本原文
.tmp/

# 自检产生的模拟报告（跑一次生成一批，没有留存价值）
config/probe-reports/_selftest/

# ── 第三方版权内容：不入库 ────────────────────────────────
# 技法库是从外部技能包原样收录的写作技法参考，那份技能声明「内容版权归原作者所有」，
# 本项目只在本机自用范围内参考。放进公开仓库要先取得原作者许可，所以默认排除；
# 目录本身留着（README.md 会入库），说明怎么自己补。
# 本地文件照常存在、照常生效，只是不进 git。
src/workshop/craft/*
!src/workshop/craft/README.md

# ── 常规忽略 ──────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# 打包产物：一律不进库。exe 走 Release 附件（.github/workflows/release-exe.yml），
# 二进制进了 git 就永久留在历史里，仓库会随版本膨胀。
build/
dist/
*.spec
